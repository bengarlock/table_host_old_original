#!/usr/bin/env bash
set -Eeuo pipefail

readonly REPO_DIR=/home/deploy/Projects/table_host_old_original
readonly REMOTE_BRANCH=dev
readonly NPM_BIN=/home/deploy/.local/node-v22/bin/npm
readonly NODE_BIN_DIR=/home/deploy/.local/node-v22/bin
readonly RUNTIME_WRAPPER=/home/deploy/.local/bin/table-host-legacy-staging-run
readonly SERVICE=table-host-legacy-staging.service
readonly LOCK_DIR=/home/deploy/.local/state/table-host-legacy-staging
readonly LOCK_FILE="$LOCK_DIR/update.lock"

run_as_deploy() {
  runuser -u deploy -- "$@"
}

install -d -o deploy -g deploy -m 0755 "$LOCK_DIR"
exec 9>"$LOCK_FILE"
flock -w 1800 9

[[ -d "$REPO_DIR/.git" ]] || { echo "TableHost legacy checkout is missing" >&2; exit 1; }
[[ -x "$NPM_BIN" ]] || { echo "Node staging runtime is missing" >&2; exit 1; }
[[ -x "$RUNTIME_WRAPPER" ]] || { echo "TableHost legacy runtime wrapper is missing" >&2; exit 1; }
[[ -z "$(run_as_deploy git -C "$REPO_DIR" status --porcelain)" ]] || {
  echo "TableHost legacy checkout is not clean" >&2
  exit 1
}

run_as_deploy git -C "$REPO_DIR" fetch --prune origin "$REMOTE_BRANCH"
run_as_deploy git -C "$REPO_DIR" merge --ff-only "origin/$REMOTE_BRANCH"
revision="$(run_as_deploy git -C "$REPO_DIR" rev-parse HEAD)"

run_as_deploy env \
  PATH="$NODE_BIN_DIR:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin" \
  NODE_OPTIONS=--openssl-legacy-provider \
  BROWSER=none \
  "$NPM_BIN" --prefix "$REPO_DIR/front_end" ci
run_as_deploy env \
  PATH="$NODE_BIN_DIR:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin" \
  NODE_OPTIONS=--openssl-legacy-provider \
  "$NPM_BIN" --prefix "$REPO_DIR/front_end" run build

run_as_deploy "$RUNTIME_WRAPPER" bash -c '
  set -Eeuo pipefail
  cd "$1/back_end"
  bundle install
  DISABLE_SPRING=1 bundle exec rails db:create db:migrate
  DISABLE_SPRING=1 bundle exec rails runner "DemoDataSeeder.call"
  DISABLE_SPRING=1 bundle exec rails test
' -- "$REPO_DIR"

systemctl restart "$SERVICE"
curl --fail --silent --show-error http://127.0.0.1:6436/tables >/dev/null
curl --fail --silent --show-error -H 'Host: DS9' http://127.0.0.1/firstproject/ >/dev/null

echo "TableHost legacy staging is healthy at $revision"
